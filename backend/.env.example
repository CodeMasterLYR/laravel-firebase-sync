APP_NAME="Laravel Firebase Sync"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite

# ──────────────────────────────────────────────────────────────────
# Firebase Configuration
# Option A: provide path to your downloaded service-account JSON
# ──────────────────────────────────────────────────────────────────
FIREBASE_CREDENTIALS=/path/to/service-account.json

# Option B: paste individual values from the JSON (if not using file)
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_PRIVATE_KEY_ID=abc123
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
# FIREBASE_CLIENT_ID=123456789

# Realtime Database URL (find at Firebase Console > Realtime Database)
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com

# ──────────────────────────────────────────────────────────────────
# Server-to-Server API Key
# External apps send this as: X-API-KEY: <value>
# Generate: php artisan tinker --execute="echo Str::random(64);"
# ──────────────────────────────────────────────────────────────────
SERVER_API_KEY=your-secure-random-key-here

SANCTUM_STATEFUL_DOMAINS=localhost:3000
SESSION_DOMAIN=localhost
