# ── Environment (NEVER commit) ────────────────────────────────────
.env
.env.local
.env.*.local

# ── Firebase Service Account (NEVER commit) ───────────────────────
*service-account*.json
*firebase-adminsdk*.json
*credentials*.json
storage/cacert.pem

# ── Backend (Laravel) ─────────────────────────────────────────────
backend/vendor/
backend/.env
